{
  "name": "raddad-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static site for the Rad Dad band homepage.",
  "scripts": {
    "build:production": "node scripts/build-sites.mjs --client-only",
    "build:preview": "npm run build:production && node scripts/build-preview.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "lint:deploy": "shellcheck scripts/deploy/server-deploy.sh tests/deploy/server-deploy.test.sh",
    "serve:test": "node scripts/serve-test.cjs",
    "test": "npm run test:docs && npm run test:unit && npm run test:deploy && npm run test:e2e",
    "test:docs": "node --test tests/docs/*.test.mjs",
    "test:artifact": "vitest run tests/unit/production-artifact.test.js",
    "test:deploy": "bash tests/deploy/server-deploy.test.sh",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:install-browsers": "playwright install chromium",
    "verify:production": "node scripts/verify-production-artifact.mjs --artifact-dir dist/client"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  }
}
